# Backend API config
PORT=8000
HOST=127.0.0.1

# AI / RAG
GEMINI_API_KEY=your_gemini_api_key_here
CHROMA_PERSIST_DIR=./backend/data/chroma

# LangSmith tracing (optional but recommended for debugging/observability)
LANGSMITH_TRACING=true
LANGSMITH_TRACING_V2=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=studyassistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional: set these if you want to override LangSmith defaults
# LANGSMITH_API_URL=https://api.smith.langchain.com
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
